# Copiar a .env y ajustar
JWT_SECRET=cambiar-esto-en-produccion
JWT_EXPIRE_MINUTES=480
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
CORS_ORIGINS=http://localhost:5180
GEMINI_API_KEY=
SEED_ON_EMPTY=true
DATA_SOURCE_MODE=red_rooster
# RED_ROOSTER_JSON=C:/ruta/BD/pedidos.json
RED_ROOSTER_POLL_SECONDS=60
# DATA_PRIVACY_KEY=clave-local-estable-de-al-menos-16-caracteres
# DATABASE_URL=sqlite:///ruta/absoluta/red_rooster.db (por defecto backend/data/red_rooster.db)
GEMINI_MODEL=gemini-2.5-flash
APRIORI_MIN_SUPPORT=0.005
APRIORI_MIN_CONFIDENCE=0.15
APRIORI_MIN_LIFT=1.0
DEMANDA_TEST_DIAS=30
